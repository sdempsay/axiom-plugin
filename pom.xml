<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.dempsay.maven</groupId>
    <artifactId>dempsay-parent</artifactId>
    <version>1.0.4</version>
  </parent>

  <groupId>org.dempsay.axiom</groupId>
  <artifactId>axiom-plugin</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>Axiom Plugin</name>
  <description>Schema, model, annotations, and Maven plugin for Axiom catalogs</description>
  <url>https://github.com/sdempsay/axiom-plugin</url>
  <organization>
    <name>Dempsay.org</name>
    <url>http://www.dempsay.org</url>
  </organization>
  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/licenses/MIT</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <modules>
    <module>model</module>
    <module>plugin</module>
  </modules>

  <properties>
    <exceptional.version>1.0.9</exceptional.version>
    <jackson.version>2.18.2</jackson.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.dempsay.axiom</groupId>
        <artifactId>axiom-model</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.dempsay.axiom</groupId>
        <artifactId>axiom-maven-plugin</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.dempsay.utils</groupId>
        <artifactId>exceptional</artifactId>
        <version>${exceptional.version}</version>
      </dependency>
      <dependency>
        <groupId>com.fasterxml.jackson.core</groupId>
        <artifactId>jackson-databind</artifactId>
        <version>${jackson.version}</version>
      </dependency>
      <dependency>
        <groupId>com.fasterxml.jackson.dataformat</groupId>
        <artifactId>jackson-dataformat-yaml</artifactId>
        <version>${jackson.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <plugins>
      <!--
        dempsay-parent 1.0.4: versions-maven-plugin 2.21.0 reports break site 3.12.1
        (NoSuchMethodError AbstractVersionsReport.getOutputPath). Skip reports until
        the parent is fixed; site:stage still produces a basic site.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-site-plugin</artifactId>
        <configuration>
          <generateReports>false</generateReports>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
